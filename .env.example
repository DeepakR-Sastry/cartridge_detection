# Copy to .env, set a real password, never commit .env.
CF_PASSWORD=change-me-to-something-long
CF_SESSION_DAYS=30
CF_TOP_K=3
# Set to 0 only for local http testing. Must be 1 behind the tunnel,
# or the cookie travels in the clear.
CF_COOKIE_SECURE=0

CF_RECOGNIZER=paddle
CF_FOUND_CONF=0.75
CF_JOB_ROOT=runs/jobs
CF_JOB_TTL_MIN=60
CF_DELIVER_MAX=1600